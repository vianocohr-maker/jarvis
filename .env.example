# ============================================================================
#  THE BRAIN  —  pick one. The default costs nothing.
# ============================================================================
#
#  gemini      FREE. 1,500 requests/day, 15/min, CAN SEE IMAGES, no credit card.
#              Key: https://aistudio.google.com/apikey
#              Caveat: Google may train on free-tier prompts. Paid tier does not.
#
#  groq        FREE tier, very fast. Llama 4 Scout can see images.
#              Key: https://console.groq.com/keys
#
#  lmstudio    FREE, private, offline, no key at all. Uses the model you have
#              loaded in LM Studio (Developer -> Start Server first).
#              Your Qwen3.5-9B is text-only and slow on this CPU — good as a
#              fallback, not as the daily driver.
#
#  openrouter  FREE models exist (look for names ending in :free).
#  cerebras    FREE tier, very fast.
#  claude      PAID, best answers. Needs credit on the Anthropic account.
#
BRAIN=gemini

# Free key from https://aistudio.google.com/apikey — takes a minute, no card.
GEMINI_API_KEY=

# Only if BRAIN=claude
ANTHROPIC_API_KEY=

# Only for groq / openrouter / cerebras. Leave blank for lmstudio / ollama.
BRAIN_API_KEY=

# Optional. Blank picks a sensible free default for the chosen provider.
BRAIN_MODEL=

# Optional. Only needed for an OpenAI-compatible host that is not a known
# preset (lmstudio, ollama, groq, openrouter, cerebras).
BRAIN_BASE_URL=

# Optional. Set true only if you know the loaded model can see images —
# guessing wrong means it silently ignores the picture.
BRAIN_VISION=

# ============================================================================
#  SPEECH IN  —  free by default
# ============================================================================
# "browser" is free and needs no key, but it is noticeably worse in noise and
# does not exist on iOS. "deepgram" is ~$0.0043/min with much better latency.
STT_PROVIDER=browser
DEEPGRAM_API_KEY=

# ============================================================================
#  SPEECH OUT  —  free by default
# ============================================================================
# "client"     the device speaks it. Free, zero setup, zero round trip.
# "sapi"       Windows voices, offline, rendered here and shipped.
# "elevenlabs" the one you will actually want. Paid.
TTS_PROVIDER=client
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ============================================================================
#  WAKE WORD  —  runs on the CLIENT, so audio does not stream until it fires
# ============================================================================
# Free personal AccessKey: https://console.picovoice.ai
# Leave blank to use push-to-talk (hold SPACE) instead.
PICOVOICE_ACCESS_KEY=

# ============================================================================
PORT=8787
