# ---- Required ----------------------------------------------------------------
# The brain. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---- Speech to text ---------------------------------------------------------
# "deepgram" (streaming, ~$0.0043/min, best latency) or "browser" (free, uses
# the client's built-in recognition — fine to start, worse in noise).
STT_PROVIDER=browser
DEEPGRAM_API_KEY=

# ---- Text to speech ---------------------------------------------------------
# "client" (the device speaks it, zero setup), "sapi" (Windows voices), or
# "elevenlabs" (the good voice).
TTS_PROVIDER=client
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- Wake word (runs on the CLIENT so audio does not stream until called) ----
# Free personal AccessKey: https://console.picovoice.ai
# Leave blank to use push-to-talk (hold SPACE) instead.
PICOVOICE_ACCESS_KEY=

# ---- Server -----------------------------------------------------------------
PORT=8787
MODEL=claude-opus-5
